        lcdc1 = "/lcdc@ff940000";
        spi0 = "/spi@ff110000";
        spi1 = "/spi@ff120000";
        spi2 = "/spi@ff130000";
    };
    memory {
        device_type = "memory";
        reg = <0x00000000 0x00000000>;
    };
