            interrupts = <0x00000000 0x00000051 0x00000004>;
            clocks = <0x00000005 0x00000004>;
            gpio-controller;
            #gpio-cells = <0x00000002>;
            interrupt-controller;
            #interrupt-cells = <0x00000002>;
            linux,phandle = <0x00000003>;
            phandle = <0x00000003>;
        };
        gpio1@ff780000 {
